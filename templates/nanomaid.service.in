[Unit]
Description=NanoMaid Telegram wrapper for OpenCode
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
Environment=HOME=@HOME@
Environment=PATH=@NODE_BIN@:@LOCAL_BIN@:/usr/local/bin:/usr/bin:/bin
Environment=OPENCODE_TELEGRAM_HOME=@BOT_HOME@
WorkingDirectory=@HOME@
ExecStart=@NANOMAID_BIN@ start
Restart=on-failure
RestartSec=10
UMask=0077

[Install]
WantedBy=default.target
